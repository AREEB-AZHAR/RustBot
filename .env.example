# RustBot Environment Configuration Example
# Copy this file to .env and set your secrets.

# Environment mode: development | production
RUSTBOT_ENV=development

# Server Binding (use 0.0.0.0 for public exposure or 127.0.0.1 for local/reverse proxy)
RUSTBOT_HOST=127.0.0.1
RUSTBOT_PORT=7878

# Public Origin (used for strict Host / Origin checks and cookies)
# In development: http://127.0.0.1:7878
# In production: https://rustbot.duckdns.org
RUSTBOT_PUBLIC_ORIGIN=http://127.0.0.1:7878

# Database Path
RUSTBOT_DATABASE_URL=rustbot.db

# OpenRouter API Key (Server-side only; never sent to browser)
OPENROUTER_API_KEY=

# CoinGecko Demo API Key (optional)
COINGECKO_API_KEY=

# Session Pepper for hashing session tokens (random high-entropy string)
RUSTBOT_SESSION_PEPPER=

# Solana Live Trading Configuration
# Export base58 private key from Phantom (Settings -> Manage Accounts -> Show Private Key)
# NEVER commit .env to git or share this key!
SOLANA_LIVE_ENABLED=false
SOLANA_PRIVATE_KEY=
# Solana RPC endpoint (default public mainnet, or your free Helius/QuickNode RPC URL)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Minimum native SOL reserved untouched for transaction fees and rent (default: 0.008 SOL)
SOLANA_MIN_GAS_RESERVE_SOL=0.008
# Optional Jupiter API key for higher rate limits (https://jup.ag)
JUPITER_API_KEY=
